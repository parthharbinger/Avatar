# ================================================
# REAL-TIME AI AVATAR BACKEND — ENV CONFIG
# Copy this to .env and fill in your values
# ================================================

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Session Management
SESSION_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SESSIONS=20

# CORS (use specific origins in production)
CORS_ORIGINS=["*"]

# ------------------------------------------------
# TTS Provider: "edge-tts" | "elevenlabs" | "openai"
# ------------------------------------------------
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-JennyNeural

# ElevenLabs (optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------
# Avatar Video Provider:
# "d-id" | "simli" | "anam" | "akool" | "heygen" | "canvas"
# ------------------------------------------------
AVATAR_PROVIDER=d-id

# D-ID (get key from studio.d-id.com)
DID_API_KEY=your_did_api_key_here
DID_SOURCE_URL=https://clips-presenters.d-id.com/v2/Alyssa_NoHands_BlackShirt_Home/Mvn6Nalx90/y0J6MTfOaZ/image.png

# Simli (get key from simli.com / docs.simli.com)
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=tmp9i8bbq7v

# Anam.ai (get key from anam.ai / docs.anam.ai)
ANAM_API_KEY=your_anam_api_key_here
ANAM_PERSONA_ID=default

# Akool (get key from akool.com / docs.akool.com)
AKOOL_API_KEY=your_akool_api_key_here
AKOOL_CLIENT_ID=your_akool_client_id_here

# HeyGen (get key from app.heygen.com)
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=default

# LLM & ASR (Groq Cloud — Free high-speed LPU)
GROQ_API_KEY=your_groq_api_key_here
