# ================================================
# REAL-TIME 2D AI AVATAR BACKEND — ENV CONFIG
# Copy this to .env and fill in your values
# ================================================

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Session Management
SESSION_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SESSIONS=20

# CORS (use specific origins in production)
CORS_ORIGINS=["*"]

# ------------------------------------------------
# TTS Provider: "edge-tts" | "elevenlabs" | "openai"
# ------------------------------------------------
TTS_PROVIDER=edge-tts

# Edge-TTS (no API key needed)
EDGE_TTS_VOICE=en-US-AriaNeural

# ElevenLabs (only needed if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI (only needed if TTS_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------
# Avatar Video Provider: "edge-tts" (2D Canvas $0) | "d-id" (WebRTC) | "heygen" (WebRTC)
# ------------------------------------------------
AVATAR_PROVIDER=edge-tts

# D-ID (get key from studio.d-id.com)
DID_API_KEY=your_did_api_key_here
DID_SOURCE_URL=https://raw.githubusercontent.com/d-id/create-stream-webrtc/main/emma.png

# HeyGen (get key from app.heygen.com)
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=default

# ASR — Groq Whisper (optional, for voice input support)
GROQ_API_KEY=your_groq_api_key_here
